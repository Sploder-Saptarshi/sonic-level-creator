{
  "name": "sonic-level-creator",
  "version": "1.0.0",
  "private": true,
  "description": "Sonic Level Creator editor — TypeScript sources bundled to public/editors/assets/editor.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build:editor && nitro build",
    "build:editor": "esbuild ts/main.ts --bundle --format=iife --outfile=public/editors/assets/editor.js --log-level=info",
    "dev": "nitro dev",
    "preview": "nitro preview",
    "serve": "node .output/server/index.mjs",
    "deploy:pages": "NITRO_PRESET=cloudflare_pages nitro build --preset cloudflare_pages && wrangler pages deploy dist --project-name sonicrelvl --branch main",
    "lint": "node --check public/editors/assets/editor.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "nitro": "^3.0.260903-beta",
    "typescript": "^7.0.2",
    "wrangler": "^4.133.0"
  },
  "dependencies": {
    "argon2-wasm-edge": "^1.0.23",
    "better-auth": "^1.7.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2"
  }
}
