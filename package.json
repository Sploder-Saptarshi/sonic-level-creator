{
  "name": "sonic-level-creator",
  "version": "1.0.0",
  "private": true,
  "description": "Sonic Level Creator editor — TypeScript sources bundled to public/editors/assets/editor.js",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "esbuild ts/main.ts --bundle --format=iife --outfile=public/editors/assets/editor.js --log-level=info",
    "lint": "node --check public/editors/assets/editor.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
